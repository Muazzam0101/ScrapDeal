rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users and Profiles collection
    // Users can read other user profiles (for deal discovery) but only write their own
    match /users/{userId} {
      allow read: if isAuthenticated();

      // On create, verification status must not be client-fabricated as verified
      allow create: if isOwner(userId)
        && (!request.resource.data.keys().hasAny(['identityVerificationStatus', 'authorizationVerificationStatus', 'isVerified'])
            || (request.resource.data.identityVerificationStatus in ['not_started', 'pending']
                && request.resource.data.authorizationVerificationStatus in ['not_started', 'pending']
                && request.resource.data.isVerified != true));

      // On update, clients cannot modify or tamper with verification statuses
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'identityVerificationStatus', 'authorizationVerificationStatus', 'isVerified', 'verificationStatus'
        ]);

      allow delete: if false; // Profiles cannot be arbitrarily deleted by clients
    }

    // Material Prices (Recycler Rates & Historical Prices)
    match /materialPrices/{priceId} {
      // Authenticated users can read prices for marketplace transparency
      allow read: if isAuthenticated();

      // Only the offering recycler can create their own rate
      allow create: if isAuthenticated()
        && request.resource.data.recyclerId == request.auth.uid;

      // Only the owning recycler can update their own rate (cannot modify another recycler's rate)
      allow update: if isAuthenticated()
        && resource.data.recyclerId == request.auth.uid
        && request.resource.data.recyclerId == request.auth.uid;

      // Only the owning recycler can delete their rate
      allow delete: if isAuthenticated()
        && resource.data.recyclerId == request.auth.uid;
    }

    // Material Lots collection
    match /lots/{lotId} {
      // Authenticated collectors and recyclers can view lots
      allow read: if isAuthenticated();

      // Only the collector can create their own lot
      allow create: if isAuthenticated()
        && request.resource.data.collectorId == request.auth.uid;

      // Lot updates: Collector can update their lot; Recyclers can lock/offer on status fields
      allow update: if isAuthenticated() && (
        resource.data.collectorId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'selectedRecyclerId', 'agreedRatePerKg', 'agreedTotalAmount', 'updatedAt', 'pickupOption'
        ])
      );

      // Only lot owner can delete unfinalized lots
      allow delete: if isAuthenticated()
        && resource.data.collectorId == request.auth.uid
        && resource.data.status in ['draft', 'created'];
    }

    // Offers collection
    match /offers/{offerId} {
      allow read: if isAuthenticated();

      // Only the offering recycler can create an offer
      allow create: if isAuthenticated()
        && request.resource.data.recyclerId == request.auth.uid;

      // Either party can update offer status (acceptance, counter, rejection)
      allow update: if isAuthenticated();

      allow delete: if false;
    }

    // Deals collection
    match /deals/{dealId} {
      allow read: if isAuthenticated() && (
        resource.data.collectorId == request.auth.uid ||
        resource.data.recyclerId == request.auth.uid
      );

      allow create: if isAuthenticated() && (
        request.resource.data.collectorId == request.auth.uid ||
        request.resource.data.recyclerId == request.auth.uid
      );

      allow update: if isAuthenticated() && (
        resource.data.collectorId == request.auth.uid ||
        resource.data.recyclerId == request.auth.uid
      );

      allow delete: if false;
    }

    // Handovers collection
    match /handovers/{handoverId} {
      allow read: if isAuthenticated() && (
        resource.data.collectorId == request.auth.uid ||
        resource.data.recyclerId == request.auth.uid
      );

      allow create: if isAuthenticated() && (
        request.resource.data.collectorId == request.auth.uid ||
        request.resource.data.recyclerId == request.auth.uid
      );

      allow update: if isAuthenticated() && (
        resource.data.collectorId == request.auth.uid ||
        resource.data.recyclerId == request.auth.uid
      );

      allow delete: if false;
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // Only transaction participants can read
      allow read: if isAuthenticated() && (
        resource.data.collectorId == request.auth.uid ||
        resource.data.recyclerId == request.auth.uid
      );

      // Either participant can record a transaction
      allow create: if isAuthenticated() && (
        request.resource.data.collectorId == request.auth.uid ||
        request.resource.data.recyclerId == request.auth.uid
      );

      // Cannot tamper with transaction amount or agreed price on update
      allow update: if isAuthenticated() && (
        (resource.data.collectorId == request.auth.uid || resource.data.recyclerId == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'totalAmount', 'agreedPrice', 'finalWeight', 'collectorId', 'recyclerId', 'dealId'
        ])
      );

      allow delete: if false;
    }

    // Payments collection (Phase 6)
    match /payments/{paymentId} {
      // Only payment participants can read
      allow read: if isAuthenticated() && (
        resource.data.collectorId == request.auth.uid ||
        resource.data.recyclerId == request.auth.uid
      );

      // Recycler or Collector can create a legitimate payment record
      // Initial status cannot be blindly created as completed
      allow create: if isAuthenticated() && (
        (request.resource.data.collectorId == request.auth.uid ||
         request.resource.data.recyclerId == request.auth.uid)
        && request.resource.data.status in ['pending', 'initiated', 'processing']
      );

      // Updates: Participants can confirm their respective steps
      // Amount, currency, dealId, collectorId, recyclerId cannot be altered
      allow update: if isAuthenticated() && (
        (resource.data.collectorId == request.auth.uid || resource.data.recyclerId == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'amount', 'currency', 'dealId', 'collectorId', 'recyclerId'
        ])
      );

      allow delete: if false;
    }

    // In-app Notifications collection (Phase 6)
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Authenticated system/users can create notification for participants
      allow create: if isAuthenticated();

      // Recipient can mark notification as read
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt', 'syncStatus', 'lastSyncedAt']);

      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Device Tokens collection (Phase 6 FCM)
    match /deviceTokens/{tokenId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}

