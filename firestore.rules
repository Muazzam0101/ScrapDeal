rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Toggle for development & testing phase.
    // Set to true to permit seamless sync in local/web environments where Phone Auth SMS / recaptcha is mocked.
    // Set to false for strict production deployment with Firebase Auth.
    function isDevMode() {
      return true;
    }

    function isOwner(userId) {
      return isDevMode() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Users and Profiles collection
    // Users can read other user profiles (for deal discovery) but only write their own
    match /users/{userId} {
      allow read: if isDevMode() || isAuthenticated();

      // On create, verification status must not be client-fabricated as verified in production
      allow create: if isDevMode() || (isOwner(userId)
        && (!request.resource.data.keys().hasAny(['identityVerificationStatus', 'authorizationVerificationStatus', 'isVerified'])
            || (request.resource.data.identityVerificationStatus in ['not_started', 'pending']
                && request.resource.data.authorizationVerificationStatus in ['not_started', 'pending']
                && request.resource.data.isVerified != true)));

      // On update, clients cannot modify or tamper with verification statuses in production
      allow update: if isDevMode() || (isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'identityVerificationStatus', 'authorizationVerificationStatus', 'isVerified', 'verificationStatus'
        ]));

      allow delete: if false;
    }

    // Material Prices (Recycler Rates & Historical Prices)
    match /materialPrices/{priceId} {
      allow read: if isDevMode() || isAuthenticated();
      allow create: if isDevMode() || (isAuthenticated() && request.resource.data.recyclerId == request.auth.uid);
      allow update: if isDevMode() || (isAuthenticated() && resource.data.recyclerId == request.auth.uid && request.resource.data.recyclerId == request.auth.uid);
      allow delete: if isDevMode() || (isAuthenticated() && resource.data.recyclerId == request.auth.uid);
    }

    // Material Lots collection
    match /lots/{lotId} {
      allow read: if isDevMode() || isAuthenticated();
      allow create: if isDevMode() || (isAuthenticated() && request.resource.data.collectorId == request.auth.uid);
      allow update: if isDevMode() || (isAuthenticated() && (
        resource.data.collectorId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'selectedRecyclerId', 'agreedRatePerKg', 'agreedTotalAmount', 'updatedAt', 'pickupOption'
        ])
      ));
      allow delete: if isDevMode() || (isAuthenticated() && resource.data.collectorId == request.auth.uid && resource.data.status in ['draft', 'created']);
    }

    // Offers collection
    match /offers/{offerId} {
      allow read: if isDevMode() || isAuthenticated();
      allow create: if isDevMode() || (isAuthenticated() && request.resource.data.recyclerId == request.auth.uid);
      allow update: if isDevMode() || isAuthenticated();
      allow delete: if false;
    }

    // Deals collection
    match /deals/{dealId} {
      allow read: if isDevMode() || (isAuthenticated() && (
        resource.data.collectorId == request.auth.uid ||
        resource.data.recyclerId == request.auth.uid
      ));
      allow create: if isDevMode() || (isAuthenticated() && (
        request.resource.data.collectorId == request.auth.uid ||
        request.resource.data.recyclerId == request.auth.uid
      ));
      allow update: if isDevMode() || (isAuthenticated() && (
        resource.data.collectorId == request.auth.uid ||
        resource.data.recyclerId == request.auth.uid
      ));
      allow delete: if false;
    }

    // Handovers collection
    match /handovers/{handoverId} {
      allow read: if isDevMode() || (isAuthenticated() && (
        resource.data.collectorId == request.auth.uid ||
        resource.data.recyclerId == request.auth.uid
      ));
      allow create: if isDevMode() || (isAuthenticated() && (
        request.resource.data.collectorId == request.auth.uid ||
        request.resource.data.recyclerId == request.auth.uid
      ));
      allow update: if isDevMode() || (isAuthenticated() && (
        resource.data.collectorId == request.auth.uid ||
        resource.data.recyclerId == request.auth.uid
      ));
      allow delete: if false;
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if isDevMode() || (isAuthenticated() && (
        resource.data.collectorId == request.auth.uid ||
        resource.data.recyclerId == request.auth.uid
      ));
      allow create: if isDevMode() || (isAuthenticated() && (
        request.resource.data.collectorId == request.auth.uid ||
        request.resource.data.recyclerId == request.auth.uid
      ));
      allow update: if isDevMode() || (isAuthenticated() && (
        (resource.data.collectorId == request.auth.uid || resource.data.recyclerId == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'totalAmount', 'agreedPrice', 'finalWeight', 'collectorId', 'recyclerId', 'dealId'
        ])
      ));
      allow delete: if false;
    }

    // Payments collection (Phase 6)
    match /payments/{paymentId} {
      allow read: if isDevMode() || (isAuthenticated() && (
        resource.data.collectorId == request.auth.uid ||
        resource.data.recyclerId == request.auth.uid
      ));
      allow create: if isDevMode() || (isAuthenticated() && (
        (request.resource.data.collectorId == request.auth.uid ||
         request.resource.data.recyclerId == request.auth.uid)
        && request.resource.data.status in ['pending', 'initiated', 'processing']
      ));
      allow update: if isDevMode() || (isAuthenticated() && (
        (resource.data.collectorId == request.auth.uid || resource.data.recyclerId == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'amount', 'currency', 'dealId', 'collectorId', 'recyclerId'
        ])
      ));
      allow delete: if false;
    }

    // In-app Notifications collection (Phase 6)
    match /notifications/{notificationId} {
      allow read: if isDevMode() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isDevMode() || isAuthenticated();
      allow update: if isDevMode() || (isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt', 'syncStatus', 'lastSyncedAt']));
      allow delete: if isDevMode() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Device Tokens collection (Phase 6 FCM)
    match /deviceTokens/{tokenId} {
      allow read: if isDevMode() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isDevMode() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update: if isDevMode() || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid);
      allow delete: if isDevMode() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // AI Predictions collection (Phase 5)
    match /aiPredictions/{predictionId} {
      allow read: if isDevMode() || isAuthenticated();
      allow write: if isDevMode() || isAuthenticated();
    }

    // AI Price Estimates collection (Phase 5)
    match /aiPriceEstimates/{estimateId} {
      allow read: if isDevMode() || isAuthenticated();
      allow write: if isDevMode() || isAuthenticated();
    }

    // AI Anomaly Events collection (Phase 5)
    match /anomalyEvents/{eventId} {
      allow read: if isDevMode() || isAuthenticated();
      allow write: if isDevMode() || isAuthenticated();
    }

    // AI Feedback collection (Phase 5)
    match /aiFeedback/{feedbackId} {
      allow read: if isDevMode() || isAuthenticated();
      allow write: if isDevMode() || isAuthenticated();
    }

    // ==========================================
    // Phase 7: Digital Traceability & Compliance
    // ==========================================

    // Traceability Records
    match /traceabilityRecords/{traceabilityId} {
      allow read: if isDevMode() || (isAuthenticated() && (
        resource.data.collectorId == request.auth.uid ||
        resource.data.recyclerId == request.auth.uid
      ));
      allow create: if isDevMode() || (isAuthenticated() && (
        request.resource.data.collectorId == request.auth.uid ||
        request.resource.data.recyclerId == request.auth.uid
      ));
      // Immutability protection: historical collection fields & original weight cannot be tampered with
      allow update: if isDevMode() || (isAuthenticated() && (
        (resource.data.collectorId == request.auth.uid || resource.data.recyclerId == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'traceabilityId', 'lotId', 'collectorId', 'estimatedWeight',
          'initialMaterial', 'collectionTimestamp', 'qrReferenceToken'
        ])
      ));
      allow delete: if false;
    }

    // Traceability Audit Events (STRICTLY IMMUTABLE)
    match /traceabilityEvents/{eventId} {
      allow read: if isDevMode() || (isAuthenticated() && (
        resource.data.actorId == request.auth.uid ||
        resource.data.collectorId == request.auth.uid ||
        resource.data.recyclerId == request.auth.uid
      ));
      // Users can append new audit events for their actions
      allow create: if isDevMode() || (isAuthenticated() && (
        request.resource.data.actorId == request.auth.uid
      ));
      // Historical audit events can NEVER be updated or deleted
      allow update: if false;
      allow delete: if false;
    }

    // Handover Confirmations (Two-Party Confirmation Records)
    match /handoverConfirmations/{confirmationId} {
      allow read: if isDevMode() || isAuthenticated();
      allow create: if isDevMode() || (isAuthenticated() && (
        request.resource.data.confirmedBy == request.auth.uid
      ));
      allow update: if false;
      allow delete: if false;
    }

    // Handover Photos Metadata
    match /handoverPhotos/{photoId} {
      allow read: if isDevMode() || isAuthenticated();
      allow create: if isDevMode() || (isAuthenticated() && (
        request.resource.data.capturedBy == request.auth.uid
      ));
      allow update: if false;
      allow delete: if false;
    }

    // Public / Controlled Verification References
    match /verificationReferences/{refId} {
      allow read: if true; // Publicly verifiable without private identity leakage
      allow write: if isDevMode() || isAuthenticated();
    }

    // Safety Guides (Phase 8 - Broadly readable for offline/field safety guidance)
    match /safetyGuides/{guideId} {
      allow read: if true; // Safety guidance is publicly accessible to all workers
      allow write: if isDevMode() || isAuthenticated();
    }

    // Field Feedback (Phase 8 - Field usability research from real collectors and recyclers)
    match /fieldFeedback/{feedbackId} {
      allow create: if true; // Field workers can submit feedback even if anonymous/offline
      allow read: if isDevMode() || isAuthenticated();
      allow update: if false; // Feedback records are append-only
      allow delete: if false;
    }
  }
}
